# Production environment variables for docker-compose.prod.yml
# Скопируйте этот файл в `.env` и заполните реальными значениями:
#   cp .env.production.example .env

# База данных
POSTGRES_USER=degust
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=degust_db

# JWT — обязательно сменить на длинную случайную строку (>= 32 символов)
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Публичные URL (с учётом реального домена)
# Адрес фронтенда — используется бэкендом для CORS и редиректов OAuth.
FRONTEND_URL=https://drinx-edu.example.com
# Публичный URL бэкенда — используется для редиректов OAuth и ссылок на загрузки
# (изображения, PDF/Excel-отчёты). Бэкенд слушает порт 4000.
BACKEND_URL=https://api.drinx-edu.example.com
# URL бэкенда, который фронтенд использует в браузере (зашивается на этапе сборки
# через NEXT_PUBLIC_API_URL). Если фронт и бэкенд на одном домене за реверс-прокси,
# укажите тот же домен, например https://drinx-edu.example.com/api.
BACKEND_PUBLIC_URL=https://api.drinx-edu.example.com

# OAuth (необязательно; кнопки входа на фронте пока скрыты)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
